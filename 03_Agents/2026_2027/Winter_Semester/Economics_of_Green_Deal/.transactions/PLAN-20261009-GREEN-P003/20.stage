    {
      "path": "01_Notes/2026_2027/Winter_Semester/Economics_of_Green_Deal/Week_2/US_Environmental_Policy_and_Economic_Principles.md",
      "sha256": "3c4036f9459c54b98f4cfaf95fea16fcbc5d5fa115c535ea7dd3215b915e2056",
