    {
      "path": "01_Notes/2026_2027/Winter_Semester/Economics_of_Green_Deal/assets/Week2_CBA_Table_17_1.png",
      "sha256": "77a2423ac3744b917f3957fd06f9494fcc59a9017a1c4938a4e68eaba0a97c62",
